<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

  <!-- Identity (decoupled from the .net8 csproj file name) -->
  <AssemblyName>Iag.Unity.DataAccess</AssemblyName>
  <RootNamespace>Iag.Unity.DataAccess</RootNamespace>

  <!-- NuGet metadata -->
  <PackageId>Iag.Unity.DataAccess.dll</PackageId>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <Authors>Steve Lauer</Authors>
  <Company></Company>
  <Description>Data access library that simplifies data access to a Microsoft SQL Server. Wraps SqlConnection and SqlCommand in a series of objects and methods that provide more straightforward usage. Multi-targets .NET Framework 4.6.2, .NET Standard 2.0, and .NET 8.0.</Description>
  <PackageLicenseExpression>MIT</PackageLicenseExpression> <!-- or use a <PackageLicenseFile> -->
  <RepositoryUrl>https://github.com/splauer1us/IAG-Unity-DataAccess</RepositoryUrl>

  <!-- Versioning -->
  <Version>2.1.0</Version>
  <AssemblyVersion>2.1.0.0</AssemblyVersion>
  <FileVersion>2.1.0.0</FileVersion>
  </PropertyGroup>
  





  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
